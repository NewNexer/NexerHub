function GetRealMaxStamina()
    local legitmaxstamina = 100
    if Character and Character:GetAttribute("Killer") then
        if Character:GetAttribute("Killer")=="Pursuer" or Character:GetAttribute("Killer")=="Killdroid" or Character:GetAttribute("Killer")=="Badware" then
            legitmaxstamina = 110
        elseif Character:GetAttribute("Killer")=="Harken" then
            legitmaxstamina = 114
        end
    end
    return legitmaxstamina
end
local InfiniteStamina = false
function StartInfiniteStaminaProcess()
    task.spawn(function()
        while InfiniteStamina do
            if Character then
                Character:SetAttribute("MaxStamina",math.huge)
            end
            if GameMovement.required==true then
                GameMovement.module.Stamina = math.huge
            end
            task.wait()
        end
        task.wait(.05)
        if Character then
            Character:SetAttribute("MaxStamina",(InfiniteStamina==true and math.huge or GetRealMaxStamina()))
        end
    end)
end
SimpleMovement:Toggle({
    Title = "Infinite Stamina",
    Callback = function(state)
        InfiniteStamina = state
        if InfiniteStamina == true then
            StartInfiniteStaminaProcess()
        end
    end
})

local NoStaminaLossEnabled = false
function StartNoStaminaLossProcess(stamina)
    task.spawn(function()
        while NoStaminaLossEnabled do
            if GameMovement.required==true then
                GameMovement.module.Stamina = stamina
            end
            task.wait()
        end
    end)
end
local NoStaminaLoss = SimpleMovement:Toggle({
    Title = "Freeze Stamina",
    Callback = function(state)
        NoStaminaLossEnabled = state
        if Character and Character:GetAttribute("Stamina") and NoStaminaLossEnabled == true then
            StartNoStaminaLossProcess(Character:GetAttribute("Stamina"))
        end
    end
})
StoredConnections[game:GetService("HttpService"):GenerateGUID(false)] = LocalPlayer.CharacterAdded:Connect(function()
if NoStaminaLossEnabled == true then
NoStaminaLoss:Set(false)
NoStaminaLossEnabled = false
end
end)

