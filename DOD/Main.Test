local Swing = Abilities:Section({
    Title = "Swing",
    Opened = false
})

local NoCooldownSwing = false
local NoCooldownSwingConnection1, NoCooldownSwingConnection2
local NoCooldownSwingToggle = Swing:Toggle({
    Title = "No Cooldown Swing",
    Callback = function(state)
        NoCooldownSwing = state
        if state==true then
            NoCooldownSwingConnection1 = Character:GetAttributeChangedSignal("SwingCooldown"):Connect(function()
                Character:SetAttribute("SwingCooldown","")
            end)
            NoCooldownSwingConnection2 = Character:GetAttributeChangedSignal("EjectCooldown"):Connect(function()
                Character:SetAttribute("EjectCooldown","")
            end)
        elseif state==false then
            if NoCooldownSwingConnection1 then
                NoCooldownSwingConnection1:Disconnect()
                NoCooldownSwingConnection1 = nil
            end
            if NoCooldownSwingConnection2 then
