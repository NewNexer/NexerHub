function FetchKiller()
local qualified = {}
for i,v in next, game:GetService("Players"):GetPlayers() do
if v and v:FindFirstChild("Stats") and v.Stats:FindFirstChild("KillerChance") and v.Stats:FindFirstChild("EquippedKiller") and v.Stats:FindFirstChild("Settings") and v.Stats.Settings:FindFirstChild("KindMode") then
if v.Stats.Settings.KindMode.Value == false then
qualified[v.Name] = v.Stats.KillerChance.Value
end
end
end
local killer = "None"
local min = -1
for i,v in pairs(qualified) do
if i and v then
if min<v then
killer = i
min = v
end
end
end
return game:GetService("Players"):WaitForChild(killer), game:GetService("Players"):WaitForChild(killer).Stats.EquippedKiller.Value
end

game:GetService("RunService").RenderStepped:Connect(function()
local Killer, Equippped = FetchKiller()
local Seconds = math.floor(workspace.DistributedGameTime)
GameStatus:SetDesc('⚙ Game Data ⚙\nCurrent Gamemode: '..game:GetService("ReplicatedStorage").GameSettings.Communication.Gamemode.Value..'\nCurrent Status: '..game:GetService("ReplicatedStorage").GameSettings.Communication.Status.Value..'\nCurrent Timer: '..game:GetService("ReplicatedStorage").GameSettings.Communication.Timer.Value..'\nNext Map: '..workspace.GameAssets.Lobby.Config.MapBoard.Title.SurfaceGui.Label.Text..'\nNext Killer: '..Killer.Name..' ('..Equippped..')\n\n⚙ Server Data ⚙\nDie of Death Version: '..game:GetService("ReplicatedStorage").GameSettings.Version.Value..''..game:GetService("ReplicatedStorage").GameSettings.Version.Details.Value..'\nPlace Version: '..tostring(game.PlaceVersion)..'\nServer Time: '..Seconds..' seconds\nServer ID: '..game.JobId..'\n\n⚙ Local Data ⚙\nFPS: '..math.floor(workspace:GetRealPhysicsFPS())..'\nPing: '..game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString()..'\nTime: '..os.date("%X")..'')
end)

