function DashSetUp(HumanoidRootPart)
HumanoidRootPart.ChildAdded:Connect(function(Child)
task.wait()
if Child.Name == "BodyVelocity" and (Character:GetAttribute("Ragdolled")==nil or Character:GetAttribute("Ragdolled")==0) then
if DashDuration<0.49 then
Child.MaxForce = Vector3.new(DashMaxForce,(DashMaxForce*0.05),DashMaxForce)
Child.P = DashPower
game:GetService("Debris"):AddItem(c, DashDuration)
elseif DashDuration>0.48 then
Child:Destroy()
local BodyVelocity = Instance.new("BodyVelocity")
BodyVelocity.MaxForce = Vector3.new(DashMaxForce,(DashMaxForce*0.05),DashMaxForce)
BodyVelocity.P = DashPower
BodyVelocity.Velocity = HumanoidRootPart.CFrame.LookVector * 80
BodyVelocity.Parent = HumanoidRootPart
game:GetService("Debris"):AddItem(BodyVelocity, DashDuration)
end
end
end)
end

