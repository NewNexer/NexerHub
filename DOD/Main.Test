local Animations = Window:Tab({
    Title = "Animations",
    Desc = "Animations module lets you change your character's animations.",
    Icon = "gravity:face-fun",
})

local AnimationsWarning = Animations:Paragraph({
    Title = "Animator not loaded",
    Desc = "Animator will load after you respawn.",
    Image = "gravity:triangle-exclamation-fill",
    ImageSize = 20
})

function SetSprintAnimation(id)
if Character and Character:FindFirstChild("Animations") then
for i,v in next, Character:WaitForChild("Animations"):GetChildren() do
if v.Name=="Sprint" or (v.Name:find("Sprint") or v.Name:match("Sprint")) then
v.AnimationId = id
end
end
end
end

function SetWalkAnimation(id)
if Character and Character:FindFirstChild("Animations") then
for i,v in next, Character:WaitForChild("Animations"):GetChildren() do
if v.Name=="Walk" or (v.Name:find("Walk") or v.Name:match("Walk")) then
v.AnimationId = id
end
end
end
end

function SetIdleAnimation(id)
if Character and Character:FindFirstChild("Animations") then
for i,v in next, Character:WaitForChild("Animations"):GetChildren() do
if v.Name=="Idle" or (v.Name:find("Idle") or v.Name:match("Idle")) then
v.AnimationId = id
end
end
end
end

StoredConnections[game:GetService("HttpService"):GenerateGUID(false)] = LocalPlayer.CharacterAdded:Once(function()
local canstart = false
task.delay(1, function() canstart = true end)

AnimationsWarning:Destroy()

Animations:Dropdown({
    Title = "Civilian's Animations",
    Values = {
        "Civilian",
        "Old Civilian",
        "Ghost"
    },
    Multi = false,
    Value = "Civilian",
    Callback = function(selected)
        if canstart~=true then return end
        if selected=="Civilian" then
            SetSprintAnimation("rbxassetid://137375023685630")
            SetWalkAnimation("rbxassetid://84388941697203")
            SetIdleAnimation("rbxassetid://100930402371608")
        elseif selected=="Old Civilian" then
            SetSprintAnimation("rbxassetid://79488319304371")
            SetWalkAnimation("rbxassetid://138161225743614")
            SetIdleAnimation("rbxassetid://74309548749074")
        elseif selected=="Ghost" then
            SetSprintAnimation("rbxassetid://124260679864309")
            SetWalkAnimation("rbxassetid://124260679864309")
            SetIdleAnimation("rbxassetid://110395159339100")
        end
        task.wait(.05)
        ClientAnimations:Reload()
        WindUI:Notify({
            Title = "Success",
            Content = "Applied chosen animations successfully!",
            Icon = "check",
            Duration = 3,
        })
    end
})

for i,v in pairs(game:GetService("ReplicatedStorage").ClientModules.Characters:GetChildren()) do if v.Name=="Civilian" or v.Name=="Ghost" then continue elseif v then
local temp_table = {}
for _,e in pairs(v.Skins:GetChildren()) do if e and e:FindFirstChildWhichIsA("Model") and e:FindFirstChildWhichIsA("Model"):FindFirstChild("Animations") then
table.insert(temp_table, e:FindFirstChildWhichIsA("Model").Name)
end; end
Animations:Dropdown({
    Title = ""..v.Name.."'s Animations",
    Values = temp_table,
    Multi = false,
    Value = "Default",
    Callback = function(selected)
        if canstart~=true then return end
        if selected=="Default" then
            SetSprintAnimation(v:WaitForChild(selected).Animations.Sprint.AnimationId)
            SetWalkAnimation(v:WaitForChild(selected).Animations.Walk.AnimationId)
            SetIdleAnimation(v:WaitForChild(selected).Animations.Idle.AnimationId)
        else
            SetSprintAnimation(v.Skins:WaitForChild(selected):WaitForChild(selected).Animations.Sprint.AnimationId)
            SetWalkAnimation(v.Skins:WaitForChild(selected):WaitForChild(selected).Animations.Walk.AnimationId)
            SetIdleAnimation(v.Skins:WaitForChild(selected):WaitForChild(selected).Animations.Idle.AnimationId)
        end
        task.wait(.05)
        ClientAnimations:Reload()
        WindUI:Notify({
            Title = "Success",
            Content = "Applied chosen animations successfully!",
            Icon = "check",
            Duration = 3,
        })
    end
})
end; end

end)

local Premium = Window:Tab({
    Title = "Freemium",
    Desc = "Cool stuff for especially cool people.",
    Icon = "gravity:sparkles-fill",
})

local noclip_connection = nil
local camera_connection = nil
function ApplyInvisibility(bool)
if bool == false then
task.spawn(function()
for i,v in next, Humanoid:GetPlayingAnimationTracks() do
v.Priority = Enum.AnimationPriority.Core
v:AdjustSpeed(tonumber(0))
v:Stop(tonumber(0))
end
end)
if noclip_connection then
noclip_connection:Disconnect()
noclip_connection = nil
end
if camera_connection then
camera_connection:Disconnect()
camera_connection = nil
pcall(function()
workspace.CurrentCamera.CameraSubject = Humanoid
end)
end
elseif bool == true then
local function nocollision()
for i,v in pairs(LP.Character:GetDescendants()) do
if v and v:IsA("BasePart") and v.CanCollide == true and v.Name ~= "HumanoidRootPart" then
v.CanCollide = false
end
end
if LP.Character:FindFirstChild("HumanoidRootPart") then
LP.Character:FindFirstChild("HumanoidRootPart").CanCollide = true
end
end
noclip_connection = game:GetService("RunService").Stepped:Connect(nocollision)
workspace.CurrentCamera.CameraSubject = HumanoidRootPart
camera_connection = workspace.CurrentCamera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
workspace.CurrentCamera.CameraSubject = HumanoidRootPart
end)
local Anim = Instance.new("Animation")
Anim.AnimationId = "rbxassetid://90444351114401" -- If you will use my invis, please credit me.
local loadedanim = Humanoid:LoadAnimation(Anim)
loadedanim.Priority = Enum.AnimationPriority.Action4
repeat task.wait() until loadedanim.Length > 0	
loadedanim:Play()
repeat task.wait() until loadedanim.IsPlaying
loadedanim:AdjustSpeed(tonumber(0))
loadedanim.TimePosition = 2.2
end
end

Premium:Toggle({
