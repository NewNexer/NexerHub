    Placeholder = "18",
    Value = "",
    Callback = function(text)
        if tonumber(text) then
            AutoBlockRange = tonumber(text)
        end
    end
})

local AutoBlockLookVectorTrigger = 0.45
Block:Input({
    Title = "Auto Block Look Vector Trigger",
    Desc = "Set this value from 0 to 1 only.\n0 = no line of sight, auto block will block even if you are behind killer.\n1 = auto block will strictly block only if killer looks directly at you.",
    Placeholder = "0.45",
    Value = "",
    Callback = function(text)
        if tonumber(text) then
            AutoBlockLookVectorTrigger = tonumber(text)
        end
    end
})

function BlockSetUp(klr)
local function test_1(klr)
if not klr or not klr:FindFirstChild("HumanoidRootPart") or not Character or not Character:FindFirstChild("CollisionBox") or not Character.CollisionBox:FindFirstChild("HurtBox") then return false end
local unit = ((Character:WaitForChild("CollisionBox", 60):WaitForChild("HurtBox", 60).Position - klr:WaitForChild("HumanoidRootPart", 60).Position) * Vector3.new(1,0,1)).Unit
local lookvector = klr:WaitForChild("HumanoidRootPart", 60).CFrame.LookVector * Vector3.new(1,0,1)
return (lookvector:Dot(unit) > AutoBlockLookVectorTrigger)
end
local function test_2(klr)
if not klr or not klr:FindFirstChild("HumanoidRootPart") or not Character or not Character:FindFirstChild("CollisionBox") or not Character.CollisionBox:FindFirstChild("HurtBox") then return 9000000 end
return (klr:WaitForChild("HumanoidRootPart", 60).Position - Character:WaitForChild("CollisionBox", 60):WaitForChild("HurtBox", 60).Position).Magnitude or 9000000
end
if klr and klr:WaitForChild("HumanoidRootPart", 60):FindFirstChild("Swing") then
klr:WaitForChild("HumanoidRootPart", 60).Swing.Played:Connect(function()
if (test_2(klr)<AutoBlockRange)==true and test_1(klr)==true and AutoBlock==true then
game:GetService("ReplicatedStorage").Events.RemoteFunctions.UseAbility:InvokeServer("Block")
end
end)
elseif klr and klr:WaitForChild("HumanoidRootPart", 60):FindFirstChild("Attack") then
klr:WaitForChild("HumanoidRootPart", 60).Attack.Played:Connect(function()
if (test_2(klr)<AutoBlockRange)==true and test_1(klr)==true and AutoBlock==true then
game:GetService("ReplicatedStorage").Events.RemoteFunctions.UseAbility:InvokeServer("Block")
end
end)
end
end

for i,v in next, workspace.GameAssets.Teams.Killer:GetChildren() do
if v and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChildWhichIsA("Humanoid") then
BlockSetUp(v)
end
end
StoredConnections[game:GetService("HttpService"):GenerateGUID(false)] = workspace.GameAssets.Teams.Killer.ChildAdded:Connect(function(Child)
