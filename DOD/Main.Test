function AdrenalineSetUp(Head)
Head:GetPropertyChangedSignal("Color"):Connect(function()
if Head.Color == Color3.fromRGB(180, 128, 255) then
Character:SetAttribute("Exhausted", 0)
if AdrenalinePauseRegen == false then
Character:SetAttribute("PauseRegen", 0)
Character:GetAttributeChangedSignal("PauseRegen"):Once(function()
if AdrenalinePauseRegen == false then
Character:SetAttribute("PauseRegen", 0)
end
end)
end
local Connection
Connection = Character:GetAttributeChangedSignal("WalkSpeedModifier"):Connect(function()
if Character:GetAttribute("WalkSpeedModifier") > 6 then
Character:SetAttribute("WalkSpeedModifier", AdrenalineWalkSpeedModifierDuringAbility+(Character:GetAttribute("WalkSpeedModifier")-7))
elseif Character:GetAttribute("WalkSpeedModifier") > -3 then
Character:SetAttribute("WalkSpeedModifier", AdrenalineWalkSpeedModifierEndAbility+(Character:GetAttribute("WalkSpeedModifier")+4))
Connection:Disconnect()
end
end)
Character:GetAttributeChangedSignal("Exhausted"):Once(function()
if AdrenalineExhaustion == false then
Character:SetAttribute("Exhausted", 0)
end
end)
end
end)
end

StoredConnections[game:GetService("HttpService"):GenerateGUID(false)] = LocalPlayer.CharacterAdded:Connect(function(Character)
AdrenalineSetUp(Character:WaitForChild("Head",60))
end)
