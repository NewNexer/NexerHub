local WorkspaceImmunity = Immunity:Section({
    Title = "Workspace",
    Opened = true
})

local AntiKillerDoors = false
local AntiKillerDoorsToggle
AntiKillerDoorsToggle = WorkspaceImmunity:Toggle({
    Title = "Anti-Killer Doors",
    Callback = function(state)
        AntiKillerDoors = state
        if state==true then
            if workspace.GameAssets:FindFirstChild("Map")==nil or workspace.GameAssets.Map:FindFirstChild("Config")==nil or workspace.GameAssets.Map.Config:FindFirstChild("KillerOnly")==nil then
                AntiKillerDoorsToggle:Set(false)
                WindUI:Notify({
                    Title = "Fail",
                    Content = "Killer Doors not found!",
                    Icon = "triangle-exclamation",
                    Duration = 3,
                })
                return
            end
            workspace.GameAssets.Map.Config.KillerOnly.Parent = game:GetService("CoreGui")
            workspace.GameAssets.ChildRemoved:Once(function(Child)
                if Child.Name=="Map" and game:GetService("CoreGui"):FindFirstChild("KillerOnly") then
                    game:GetService("CoreGui").KillerOnly:Destroy()
                    if AntiKillerDoors==true then
                        AntiKillerDoorsToggle:Set(false)
                    end
                end
            end)
        elseif state==false then
            if game:GetService("CoreGui"):FindFirstChild("KillerOnly") and (workspace.GameAssets:FindFirstChild("Map") and workspace.GameAssets.Map:FindFirstChild("Config")) then
                game:GetService("CoreGui").KillerOnly.Parent = workspace.GameAssets.Map.Config
            end
        end
    end
})

local AntiKillerBarriers = false
local AntiKillerBarriersToggle
AntiKillerBarriersToggle = WorkspaceImmunity:Toggle({
    Title = "Anti-Killer Barriers",
    Callback = function(state)
        AntiKillerBarriers = state
        if state==true then
            if workspace.GameAssets:FindFirstChild("Map")==nil or workspace.GameAssets.Map:FindFirstChild("Config")==nil or workspace.GameAssets.Map.Config:FindFirstChild("Barriers")==nil or workspace.GameAssets.Map.Config.Barriers:FindFirstChild("KillerBarriers")==nil then
                AntiKillerBarriersToggle:Set(false)
                WindUI:Notify({
                    Title = "Fail",
                    Content = "Killer Barriers not found!",
                    Icon = "triangle-exclamation",
                    Duration = 3,
                })
                return
            end
            workspace.GameAssets.Map.Config.Barriers.KillerBarriers.Parent = game:GetService("CoreGui")
            workspace.GameAssets.ChildRemoved:Once(function(Child)
                if Child.Name=="Map" and game:GetService("CoreGui"):FindFirstChild("KillerBarriers") then 
                    game:GetService("CoreGui").KillerBarriers:Destroy()
                    if AntiKillerBarriers==true then
                        AntiKillerBarriersToggle:Set(false)
                    end
                end
            end)
        elseif state==false then
            if game:GetService("CoreGui"):FindFirstChild("KillerBarriers") and (workspace.GameAssets:FindFirstChild("Map") and workspace.GameAssets.Map:FindFirstChild("Config")) then
                game:GetService("CoreGui").KillerBarriers.Parent = workspace.GameAssets.Map.Config
            end
        end
    end
})

