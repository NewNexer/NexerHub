        game:GetService("ReplicatedStorage").HasUserFavorited.OnClientInvoke = function() return true end
        task.wait(.05)
        SelectGlove("Acrobat")
    end
})

local AmountOfPeopleInArena
local GetAmountOfPeopleInArena = function()
AmountOfPeopleInArena = 0
for i,v in next, game:GetService("Players"):GetPlayers() do
    if v and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("entered") then
        AmountOfPeopleInArena += 1
    end
end
return AmountOfPeopleInArena
end

RegisterObtainmentButton("Instant", {
    Title = "Instant buddies",
    Desc = "You must have Golden.",
    Icon = "gravity:sparkles",
    Callback = function()
        if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
            obtainmentmsg:Destroy()
            obtainmentmsg = nil
        end
        if not Character then return end
        if Character:FindFirstChild("entered") then
            WindUI:Notify({
                Title = "Error!",
                Content = "You have to use this in lobby!",
                Icon = "gravity:triangle-exclamation",
                Duration = 3,
            })
            return
        end
        if GetAmountOfPeopleInArena()<3 then
            WindUI:Notify({
                Title = "Error!",
                Content = "There must be atleast 3 people in the arena!",
                Icon = "gravity:triangle-exclamation",
                Duration = 3,
            })
            return
        end
        if LocalPlayer.leaderstats.Glove.Value~="Golden" then
            SelectGlove("Golden")
        end
        for i,v in next, game:GetService("Players"):GetPlayers() do
            if v and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                pcall(function()
                    game:GetService("ReplicatedStorage").GoldenHit:FireServer(v.Character.HumanoidRootPart, true)
                end)
            end
        end
        task.wait(.05)
        game:GetService("ReplicatedStorage").ACH:FireServer()
    end
})

