QuestsObtainments:Button({
    Title = "Complete ''Mysterious Note''",
    Desc = "You must have Pocket or there must be a pocket room in the arena.",
    Icon = "gravity:sparkles",
    Callback = function()
        if not Character then return end
        if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
            obtainmentmsg:Destroy()
            obtainmentmsg = nil
        end
        if Character:FindFirstChild("entered") then
            WindUI:Notify({
                Title = "Error!",
                Content = "You have to use this in lobby!",
                Icon = "gravity:triangle-exclamation",
                Duration = 3,
            })
            return
        end
        obtainmentmsg = CreateMessage()
        obtainmentmsg.Text = "Getting Slender..."
        if LocalPlayer.leaderstats.Glove.Value~="Pocket" and LocalPlayer.leaderstats.Slaps>(GlovesData.Pocket.SlapRequirement-1) then
            SelectGlove("Pocket")
        end
        ActivateBadgeQuest("_questChainMysteriousNote")
        if workspace.Lobby:FindFirstChild("Teleport2") then
            EnterArena(workspace.Lobby["Teleport2"])
        else
            EnterArena(workspace.Lobby["Teleport1"])
        end
        if workspace:FindFirstChild("Lobby") then
            local grrfake = workspace.Lobby:FindFirstChild("Meshes/mr president glove", true)
            if grrfake then
                grrfake.Name = "Mesh"
            end
        end
        task.wait(.1)
        game:GetService("ReplicatedStorage").GeneralAbility:FireServer(HumanoidRootPart.CFrame)
        repeat task.wait(.05) until workspace:FindFirstChild("Meshes/mr president glove", true) and workspace:FindFirstChild("Meshes/mr president glove", true).Parent.Parent:FindFirstChildWhichIsA("ProximityPrompt")
        local roomenter = workspace:FindFirstChild("Meshes/mr president glove", true)
        TeleportToPosition(roomenter.Parent.CFrame * CFrame.new(0,3,0), 2)
        roomenter.Parent.Parent:FindFirstChildWhichIsA("ProximityPrompt").MaxActivationDistance = 13
        fireproximityprompt(roomenter.Parent.Parent:FindFirstChildWhichIsA("ProximityPrompt"))
        repeat task.wait(.05) until Character.isInArena.Value==false or Humanoid.Health==0
        if Humanoid.Health==0 then
            if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
                obtainmentmsg:Destroy()
                obtainmentmsg = nil
            end
            return
        end
        task.wait(1.5)
        local roommodel = workspace:FindFirstChild(tostring(Character:GetAttribute("InPocket")).."'s Room", true)
        fireclickdetector(roommodel.PocketKeypad.Buttons.Reset.ClickDetector)
        task.wait(.334)
        for v in tostring(LocalPlayer:GetAttribute("MysteriousHiddenCode")):gmatch("%d") do
            fireclickdetector(roommodel.PocketKeypad.Buttons[tostring(v)].ClickDetector)
            task.wait(.334)
        end
        fireclickdetector(roommodel.PocketKeypad.Buttons.Enter.ClickDetector)
        repeat task.wait(.05) until (LocalPlayer:GetAttribute("EnteredSlendermanCode")~=nil and LocalPlayer:GetAttribute("EnteredSlendermanCode")==true) or Humanoid.Health==0
        game:GetService("ReplicatedStorage").Remotes.FoundSlenderPage:FireServer()
        task.wait()
        CollectBadgeQuestReward("_questChainMysteriousNote")
        if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
            obtainmentmsg:Destroy()
            obtainmentmsg = nil
        end
    end
})

local AutoFarmObtainments = Window:Tab({
