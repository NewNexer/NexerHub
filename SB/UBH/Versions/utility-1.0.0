RegisterObtainmentButton("Automatic", {
    Title = "Auto-Get Catseye",
    Desc = "You must have Recall.",
    Icon = "gravity:sparkles",
    Callback = function()
        if not Character then return end
        if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
            obtainmentmsg:Destroy()
            obtainmentmsg = nil
        end
        if Character:FindFirstChild("entered") then
            WindUI:Notify({
                Title = "Error!",
                Content = "You have to use this in lobby!",
                Icon = "gravity:triangle-exclamation",
                Duration = 3,
            })
            return
        end
        obtainmentmsg = CreateMessage()
        obtainmentmsg.Text = "Getting Catseye..."
        if LocalPlayer.leaderstats.Glove.Value~="Recall" then
            SelectGlove("Recall")
        end
		EnterArena(workspace.Lobby["Teleport1"])
		game:GetService("ReplicatedStorage").GlitchTP:FireServer(true)
		TeleportToPosition(workspace["Debug Room"].File.CFrame, 3)
		workspace["Debug Room"].File.ProximityPrompt.HoldDuration = 0
		pcall(fireproximityprompt, workspace["Debug Room"].File.ProximityPrompt)
		for i=1,3 do
			game:GetService("ReplicatedStorage").Events.CatseyeObtainmentCanProgress:InvokeServer()
		end
		task.wait(2)
        for i=1,3 do
            game:GetService("ReplicatedStorage").ClaimRetroFastTravel:FireServer(true,true)
            TeleportToPosition(CFrame.new(-17004,-4,4542), 3)
            for i=1,3 do
                game:GetService("ReplicatedStorage").Events.CatseyeObtainmentCanProgress:InvokeServer()
            end
            LocalPlayer.Reset:FireServer()
            HumanoidRootPart.Anchored = true
            LocalPlayer.CharacterAdded:Wait()
            task.wait(1)
        end
        EnterArena(workspace.Lobby["Teleport1"])
		game:GetService("ReplicatedStorage").GlitchTP:FireServer(true)
		TeleportToPosition(workspace["Debug Room"].File.CFrame, 3)
		workspace["Debug Room"].File.ProximityPrompt.HoldDuration = 0
		pcall(fireproximityprompt, workspace["Debug Room"].File.ProximityPrompt)
		for i=1,3 do
			game:GetService("ReplicatedStorage").Events.CatseyeObtainmentCanProgress:InvokeServer()
		end
        if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
            obtainmentmsg:Destroy()
            obtainmentmsg = nil
        end
    end
})

