BulkObtainments:Button({
    Title = "Auto-Get Trap + Voodoo + Fish",
    Desc = "You must have Ghost.",
    Icon = "gravity:sparkles",
    Callback = function()
        if not Character then return end
        if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
            obtainmentmsg:Destroy()
            obtainmentmsg = nil
        end
        if Character:FindFirstChild("entered") then
            WindUI:Notify({
                Title = "Error!",
                Content = "You have to use this in lobby!",
                Icon = "gravity:triangle-exclamation",
                Duration = 3,
            })
            return
        end
        obtainmentmsg = CreateMessage()
        obtainmentmsg.Text = "Getting Trap + Voodoo + Fish..."
        if LocalPlayer.leaderstats.Glove.Value~="Ghost" then
            SelectGlove("Ghost")
        end
        game:GetService("ReplicatedStorage").Ghostinvisibilityactivated:FireServer()
        repeat task.wait() until Character.Torso.Transparency==1
        if LocalPlayer.leaderstats.Glove.Value~="ZZZZZZZ" then
            SelectGlove("ZZZZZZZ")
        end
