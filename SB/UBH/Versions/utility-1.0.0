local AutoFarmSettings = {
    ["CandyCorns"] = false,
    ["Gifts"] = false,
    ["Jet"] = false,
    ["Phase"] = false,
    ["Glitch"] = false,
    ["MATERIALIZE"] = false,
    ["Siphon"] = false,
    ["Hammer"] = false,
    ["Slapples"] = false
}

task.spawn(function()
    repeat task.wait(.1)
        if AutoFarmSettings.CandyCorns==true then
            for i,v in next, workspace.CandyCorns:GetChildren() do
                if v then
                    task.spawn(TouchObject, v)
                end
            end
        end
        if AutoFarmSettings.Gifts==true then
            for i,v in next, workspace:GetChildren() do
                if v and v.Name=="Gift" then
                    task.spawn(TouchObject, v)
                end
            end
        end
        if AutoFarmSettings.Jet==true and workspace:FindFirstChild("JetOrb") then
            task.spawn(TouchObject, workspace.JetOrb)
        end
        if AutoFarmSettings.Phase==true and workspace:FindFirstChild("PhaseOrb") then
            task.spawn(TouchObject, workspace.PhaseOrb)
        end
        if AutoFarmSettings.Glitch==true and workspace:FindFirstChild("GlitchOrb") then
            task.spawn(TouchObject, workspace.GlitchOrb)
        end
        if AutoFarmSettings.MATERIALIZE==true and workspace:FindFirstChild("MATERIALIZEOrb") then
            task.spawn(TouchObject, workspace.MATERIALIZEOrb)
        end
        if AutoFarmSettings.Siphon==true and workspace:FindFirstChild("SiphonOrb") then
            task.spawn(TouchObject, workspace.SiphonOrb)
        end
        if AutoFarmSettings.Hammer==true and workspace:FindFirstChild("Toolbox") then
            task.spawn(TouchObject, workspace.Toolbox)
        end
        if AutoFarmSettings.Hammer==true and workspace:FindFirstChild("Toolbox") then
            task.spawn(fireclickdetector, workspace.Toolbox:FindFirstChild("ClickDetector", true))
        end
        if AutoFarmSettings.Slapples==true then
            if Character and Character:FindFirstChild("entered") then
                for _,slapple in next, workspace.Arena.island5.Slapples:GetChildren() do
                    if slapple and (slapple.Name == "Slapple" or slapple.Name == "GoldenSlapple") and slapple:FindFirstChild("Glove") and Character and HumanoidRootPart and Character:FindFirstChild("entered") then
                        task.spawn(TouchObject, slapple.Glove)
                    end
                end
            end
        end
        if scriptclosed==true then break end
    until INVALID_VARIABLE~=nil
end)

