        repeat task.wait(.1) game:GetService("ReplicatedStorage").GeneralAbility:FireServer(CFrame.new(pos.X, pos.Y, pos.Z, 0, 0, 0, 0, 0, 0, 0, 1, 0)) until workspace:FindFirstChild(LocalPlayer.Name.."_door") or Humanoid.Health==0
        if Humanoid.Health==0 then
            if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
                obtainmentmsg:Destroy()
                obtainmentmsg = nil
            end
            return
        end
        TeleportToPosition(CFrame.new(0,-49990,0),1)
        repeat task.wait() until Character:FindFirstChild("Torso")==nil
        task.wait(2.6)
        task.spawn(function()
            for i=1,10 do
                print("hah")
                for i,v in next, game:GetService("Players"):GetPlayers() do
                    if v~=LocalPlayer then
                        pcall(function()
                            game:GetService("ReplicatedStorage").GeneralHit:FireServer(v.Character.HumanoidRootPart)
                        end)
                    end
                end
                task.wait(.1)
            end
        end)
        repeat task.wait() until Character and Character:FindFirstChild("Torso")
        SelectGlove("Plague")
        EnterArena(workspace.Lobby["Teleport1"])
        for i=1,100 do
            for i,v in next, game:GetService("Players"):GetPlayers() do
                if v~=LocalPlayer then
                    pcall(function()
                        for _,part in next, v.Character:GetChildren() do
                            if part:IsA("BasePart") then
                                game:GetService("ReplicatedStorage").PlagueHit:FireServer(part)
                            end
                        end
                    end)
                end
            end
            task.wait(.05)
        end
        if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
            obtainmentmsg:Destroy()
            obtainmentmsg = nil
        end
    end
})

RegisterObtainmentButton("Automatic", {
    Title = "Auto-Get Slender",
    Desc = "You must have Pocket or there must be a pocket room in the arena if the ''Mysterious Note'' quest is not completed.",
    Icon = "gravity:sparkles",
    Callback = function()
        if not Character then return end
        if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
            obtainmentmsg:Destroy()
            obtainmentmsg = nil
        end
        if Character:FindFirstChild("entered") then
            WindUI:Notify({
                Title = "Error!",
                Content = "You have to use this in lobby!",
                Icon = "gravity:triangle-exclamation",
                Duration = 3,
            })
            return
        end
        local JSONData = game:GetService("HttpService"):JSONDecode(game:GetService("ReplicatedStorage").PlayerData[LocalPlayer.Name].BadgeQuestProgress.Value)
        if JSONData._questChainMysteriousNote.completed==true and JSONData._questChainMysteriousNote.rewarded==false then
            CollectBadgeQuestReward("_questChainMysteriousNote")
        elseif JSONData._questChainMysteriousNote.completed==false then
            obtainmentmsg = CreateMessage()
            obtainmentmsg.Text = "Getting Slender..."
            if LocalPlayer.leaderstats.Glove.Value~="Pocket" and LocalPlayer.leaderstats.Slaps.Value>(GlovesData.Pocket.SlapRequirement-1) then
                SelectGlove("Pocket")
            end
            ActivateBadgeQuest("_questChainMysteriousNote")
            if workspace.Lobby:FindFirstChild("Teleport2") then
                EnterArena(workspace.Lobby["Teleport2"])
