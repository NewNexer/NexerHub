local ObtainmentRank = {}
for position, gloveName in ipairs(ObtainmentGloveOrder) do
    ObtainmentRank[gloveName:lower()] = position
end

local function GetObtainmentRank(config)
    local gloveName = config.Title:gsub("^Auto%-Get%s+", ""):gsub("^Instant%s+", ""):gsub("^Get%s+", "")
    return ObtainmentRank[gloveName:gsub(" %(%+.-%)$", ""):lower()] or (#ObtainmentGloveOrder + 1)
end

table.sort(RegisteredObtainmentButtons, function(a, b)
    local aRank = GetObtainmentRank(a.Config)
    local bRank = GetObtainmentRank(b.Config)
    if aRank ~= bRank then
        return aRank < bRank
    end
    return a.OriginalPosition < b.OriginalPosition
end)

local SelectedObtainmentFilter = "All"
local ActiveObtainmentSection

local function RefreshObtainmentButtons()
    if ActiveObtainmentSection then
        ActiveObtainmentSection:Destroy()
    end
    ActiveObtainmentSection = BadgeObtainments:Section({
        Title = SelectedObtainmentFilter == "All" and "All Obtainments" or SelectedObtainmentFilter,
        Opened = true,
    })

    if SelectedObtainmentFilter == "Instant" then
        ActiveObtainmentSection:Paragraph({
            Title = "Sequences that let you obtain gloves in less than a second."
        })
        ActiveObtainmentSection:Divider()
    elseif SelectedObtainmentFilter == "Automatic" then
        ActiveObtainmentSection:Paragraph({
            Title = "Fully automatic sequences for obtaining gloves."
        })
        ActiveObtainmentSection:Divider()
    elseif SelectedObtainmentFilter == "Help Required" then
        ActiveObtainmentSection:Paragraph({
            Title = "Sequences that require additional help for the obtainment."
        })
        ActiveObtainmentSection:Divider()
    elseif SelectedObtainmentFilter == "Location Based" then
        ActiveObtainmentSection:Paragraph({
            Title = "Sequences that require you to be in specific locations for obtainment."
        })
        ActiveObtainmentSection:Divider()
    end

    for _, obtainment in ipairs(RegisteredObtainmentButtons) do
        if SelectedObtainmentFilter == "All" or obtainment.Category == SelectedObtainmentFilter then
            ActiveObtainmentSection:Button(obtainment.Config)
        end
    end
end

BadgeObtainments:Dropdown({
    Title = "Filter",
    Values = {"All", "Automatic", "Instant", "Help Required"},
    Value = "All",
    Multi = false,
    Callback = function(selected)
        SelectedObtainmentFilter = selected
        RefreshObtainmentButtons()
    end,
})

RefreshObtainmentButtons()

