RegisterObtainmentButton("Automatic", {
    Title = "Auto-Get MEGAROCK",
    Desc = "You must have Diamond.",
    Icon = "gravity:sparkles",
    Callback = function()
        if not Character then return end
        if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
            obtainmentmsg:Destroy()
            obtainmentmsg = nil
        end
        if Character:FindFirstChild("entered") then
            WindUI:Notify({
                Title = "Error!",
                Content = "You have to use this in lobby!",
                Icon = "gravity:triangle-exclamation",
                Duration = 3,
            })
            return
        end
        obtainmentmsg = CreateMessage()
        obtainmentmsg.Text = "36000 seconds left to get MEGAROCK."
        if LocalPlayer.leaderstats.Glove.Value~="Diamond" then
            SelectGlove("Diamond")
        end
        EnterArena(workspace.Lobby["Teleport1"])
        task.wait(.5)
		game:GetService("ReplicatedStorage").Rockmode:FireServer()
        repeat task.wait() until Character:FindFirstChild("rock")
        CharacterSpawned = false
        task.spawn(function()
            for i=36000,1,-1 do
                obtainmentmsg.Text = tostring(i).." seconds left to get MEGAROCK."
                task.wait(1)
                if CharacterSpawned==true then break end
            end
            if CharacterSpawned==true then return end
            obtainmentmsg.Text = "Confirming obtainment... (≈20 seconds)"
            task.wait(20)
            game:GetService("ReplicatedStorage").DeactivateRockmode:FireServer()
            repeat task.wait() until Character:FindFirstChild("rock")==nil
            LocalPlayer.Reset:FireServer()
        end)
        LocalPlayer.CharacterAdded:Once(function()
            if obtainmentmsg~=nil and typeof(obtainmentmsg)=="Instance" and obtainmentmsg.Parent==game:GetService("CoreGui") then
                obtainmentmsg:Destroy()
                obtainmentmsg = nil
            end
            CharacterSpawned = true
        end)
    end
})

