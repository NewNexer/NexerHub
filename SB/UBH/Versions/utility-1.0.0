local RegisteredObtainmentButtons = {}
local function RegisterObtainmentButton(category, buttonConfig)
    table.insert(RegisteredObtainmentButtons, {
        Category = category,
        Config = buttonConfig,
        OriginalPosition = #RegisteredObtainmentButtons + 1,
    })
end

