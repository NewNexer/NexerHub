-- Plank tab
Plank = Window:Tab({
    Title = "Plank",
    Icon = "gravity:sparkles",
})

PlankTask1 = false
Plank:Toggle({
    Title = "Task 1 (Ambush)",
    Callback = function(state)
        PlankTask1 = state
    end
})

PlankTask2 = false
Plank:Toggle({
    Title = "Task 2 (Kill)",
    Callback = function(state)
        PlankTask2 = state
    end
})

PlankTask3 = false
Plank:Toggle({
    Title = "Task 3 (Hit)",
    Callback = function(state)
        PlankTask3 = state
    end
})

Plank:Divider()

PlankFarming = false
PlankFarmingToggle = nil
PlankFarmingToggle = Plank:Toggle({
    Title = "Start Farming",
	Icon = "gravity:sparkles",
    Callback = function(state)
        PlankFarming = state
		if PlankFarming==true and (not Character or not HumanoidRootPart or not Humanoid) then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Missing player components, please try again in a few seconds. (Character/HumanoidRootPart/Humanoid)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 4,
        	})
			PlankFarmingToggle:Set(false)
			PlankFarming = false
			return
		end
		if PlankFarming==true and Character:FindFirstChild("entered") then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Should use in lobby.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			PlankFarmingToggle:Set(false)
			PlankFarming = false
			return
		end
		if PlankFarming==true and LocalPlayer:WaitForChild("_unlockedGloves").Plank.Value==false and LocalPlayer.leaderstats.Glove.Value~="Plank" then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You don't own plank. (If you are using rent bug, equip the glove you are getting mastery for and try again)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 6,
        	})
			PlankFarmingToggle:Set(false)
			PlankFarming = false
			return
		end
		if PlankFarming==true and Humanoid.Health==0 then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You are dead.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			PlankFarmingToggle:Set(false)
			PlankFarming = false
			return
		end
		if PlankFarming==true and PlankTask1==false and PlankTask2==false and PlankTask3==false then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You need to turn on atleast 1 option.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			PlankFarmingToggle:Set(false)
			PlankFarming = false
			return
		end
		if PlankFarming==true and PlankTask1==true and (PlankTask2==true or PlankTask3==true) then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You can't combine task 1 with other tasks.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 4,
        	})
			PlankFarmingToggle:Set(false)
			PlankFarming = false
			return
		end
		if not AltAccountPlayer then
			WindUI:Notify({
    			Title = "Error",
    			Content = "Alt account not detected! Please connect the accounts!",
    			Icon = "triangle-exclamation",
    			Duration = 3,
			})
			return
		end
if PlankFarming==true then
if LocalPlayer.leaderstats.Glove.Value~="Plank" then
SelectGlove("Plank")
task.wait(.333)
end
EnterArena(workspace.Lobby["Teleport1"])
TeleportToPosition(workspace["platform1"].CFrame * CFrame.new(math.random(-500,500),10,math.random(-500,500)), 2)
HumanoidRootPart.Anchored = true
if PlankTask1==true then
HumanoidRootPart.Anchored = false
NETWORK.send_data("15")
elseif PlankTask2==true then
NETWORK.send_data("10")
elseif PlankTask3==true then
NETWORK.send_data("13")
end
task.wait(2.5)
local canslap = true
local canspawnsuperlongthingy = true
repeat task.wait()
if PlankTask1==true or PlankTask2==true or PlankTask3==true then
if canspawnsuperlongthingy==true then
canspawnsuperlongthingy = false
pcall(function()
game:GetService("ReplicatedStorage").GeneralAbility:FireServer(CFrame.new(0,9000000,0), Vector3.new(120, 3, 0.35))
end)
task.delay(.1, function() canspawnsuperlongthingy = true end)
end
if PlankTask1==true then
if Humanoid.Jump==false then
Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
PressKey("Space")
end
pcall(function()
if workspace:FindFirstChild(""..LocalPlayer.Name.."'s Plank") and (workspace[""..LocalPlayer.Name.."'s Plank"]:GetAttribute("definetilyhammered")~=nil and workspace[""..LocalPlayer.Name.."'s Plank"]:GetAttribute("definetilyhammered")==true) then
HumanoidRootPart:PivotTo(workspace[""..LocalPlayer.Name.."'s Plank"].CFrame)
end
end)
if canslap==true then
canslap = false
pcall(function()
game:GetService("ReplicatedStorage").GeneralHit:FireServer(AltAccountPlayer.Character.Head)
end)
task.delay(.8, function() canslap = true end)
end
end
end
until PlankFarming==false or Humanoid.Health==0
HumanoidRootPart.Anchored = false
Humanoid.Health = 0
LocalPlayer:WaitForChild("Reset"):FireServer()
end
    end
})
workspace.ChildAdded:Connect(function(Child)
task.wait(2)
if Child.Name==""..LocalPlayer.Name.."'s Plank" and PlankFarming==true and PlankTask1==true then
game:GetService("ReplicatedStorage").Events.PlankRAbility:FireServer("Hammer",Child,0.55)
Child:SetAttribute("definetilyhammered", true)
end
end)

