function CreateMessage(a)
local instancename = (a=="Message" and a) or "Hint"
local msg = Instance.new(instancename,game:GetService("CoreGui"))
msg.Text = ""
return msg
end

local _version = "1.6.66"
local msg = CreateMessage()
msg.Text = "Loading Modules... (0/1)"
local modules
if string.find(identifyexecutor(), "Xeno") or string.find(identifyexecutor(), "Solara") then
modules = {
	{"WindUI", "https://github.com/Footagesus/WindUI/releases/download/".._version.."/main.lua", true}
}
else
modules = {
	{"WindUI", "https://github.com/Footagesus/WindUI/releases/download/".._version.."/main.lua", true}
}
end
if not loaded_modules_sb then
getgenv().loaded_modules_sb = {}
end
local loaded, attempts = {}, {}
for i = 1, #modules do attempts[i] = 0 end
local i = 1
repeat task.wait()
	local suc, res = pcall(function()
		return table.find(loaded_modules_sb, tostring(modules[i][3])) and loaded_modules_sb[tostring(modules[i][3])] or modules[i][3] and loadstring(game:HttpGet(modules[i][2]))() or game:HttpGet(modules[i][2])
	end)
	if not suc then
		attempts[i] += 1
		msg.Text = "Failed loading module '"..modules[i][1].."', retry: "..attempts[i]
		task.wait(1)
	else
		loaded[modules[i][1]] = res
        table.insert(loaded_modules_sb, tostring(modules[i][1]))
		msg.Text = "Loading module '"..modules[i][1].."'... ("..tostring(i).."/1)"
		i += 1
		task.wait(.5)
	end
until i > #modules
local WindUI = loaded["WindUI"]
