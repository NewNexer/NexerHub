local AltAccountPlayer
function ReceiveMainAccData()
NETWORK.on_data_receive(function(datastring)
if game:GetService("Players"):FindFirstChild(datastring) then
AltAccountPlayer = game:GetService("Players"):WaitForChild(datastring)
end
end)
end

local Connector = Window:Tab({
    Title = "Connector",
    Desc = "Connector between you and your alt account.",
    Icon = "gravity:antenna-signal",
})

Connector:Paragraph({
    Title = "Instructions",
    Desc = "Firstly click on the 'Main Account' on your account where you will farm masteries, afterwards click the 'Alt Account' on your alt account that will help you get masteries.",
    Image = "shield-exclamation",
    ImageSize = 20
})

local ConnectionStatus = Connector:Paragraph({
    Title = "Connection Status",
    Desc = "Connection Status: ❌",
    Image = "shield-exclamation",
    ImageSize = 20
})

Connector:Button({
    Title = "Main Account",
    Desc = "Click this on your main account.",
    Icon = "mouse-pointer-click",
    Callback = function()
        WindUI:Notify({
            Title = "Connection",
            Content = "Empty connection provided! (Now connect 'Alt Account')",
            Icon = "check",
            Duration = 3,
        })
        NETWORK.add_connection_queue()
        WindUI:Notify({
            Title = "Connection",
            Content = "Connection established with 'Alt Account'!",
            Icon = "check",
            Duration = 5,
        })
		ConnectionStatus:SetDesc("Connection Status: ✅")
		task.wait()
		ReceiveMainAccData()
		NETWORK.send_data(LocalPlayer.Name)
    end
})

Connector:Button({
    Title = "Alt Account",
    Desc = "Click this on your alt account.",
    Icon = "mouse-pointer-click",
    Callback = function()
        NETWORK.connect_to_available()
        ReceiveData()
		ConnectionStatus:SetDesc("Connection Status: Check connection status on 'Main Account'")
        WindUI:Notify({
            Title = "Connection",
            Content = "Sent connection request. (Check connection status on 'Main Account')",
            Icon = "check",
            Duration = 6,
        })
		task.wait(1)
		NETWORK.send_data(LocalPlayer.Name)
    end
})

local FetchedHumanoids = {}
local FetchedMannequins = {}
for i,v in next, game:GetService("ReplicatedStorage").Assets:GetDescendants() do
if v and v:IsA("Model") and v:FindFirstChild("isInArena") and v.isInArena.Value==true and v:FindFirstChild("Head") then
if v.Parent.Name=="Mannequin" then
table.insert(FetchedMannequins,v.Head)
end
table.insert(FetchedHumanoids,v.Head)
end
end

