    Title = "Task 1 (Avoid Slap)",
    Callback = function(state)
        PhaseTask1 = state
    end
})

Phase:Button({
    Title = "Complete Task 2",
	Icon = "gravity:sparkles-fill",
    Callback = function()
		if not Character or not HumanoidRootPart or not Humanoid then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Missing player components, please try again in a few seconds. (Character/HumanoidRootPart/Humanoid)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 4,
        	})
			return
		end
		if LocalPlayer:WaitForChild("_unlockedGloves").Phase.Value==false and LocalPlayer.leaderstats.Glove.Value~="Phase" then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You don't own phase. (If you are using rent bug, equip the glove you are getting mastery for and try again)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 6,
        	})
			return
		end
		if Character:FindFirstChild("entered") then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Should use in lobby.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			return
		end
		if Humanoid.Health==0 then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You are dead.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			return
		end
if LocalPlayer:WaitForChild("_unlockedGloves").Ghost.Value==true and LocalPlayer.leaderstats.Glove.Value~="Ghost" then
SelectGlove("Ghost")
task.wait(.333)
end
game:GetService("ReplicatedStorage").Ghostinvisibilityactivated:FireServer()
task.wait(1)
if LocalPlayer.leaderstats.Glove.Value~="Phase" then
SelectGlove("Phase")
task.wait(.333)
end
EnterArena(workspace.Lobby["Teleport1"])
game:GetService("ReplicatedStorage").PhaseA:FireServer()
task.wait(.5)
local Teleports = {
	[1] = CFrame.new(-4,-12,-217),
	[2] = CFrame.new(-3,-12,13),
	[3] = CFrame.new(233,-22,3),
	[4] = CFrame.new(262,28,197),
	[5] = CFrame.new(-1,-12,219),
	[6] = CFrame.new(-125,-12,122),
	[7] = CFrame.new(-219,-12,1),
	[8] = CFrame.new(-390,48,-14)
}
for i,v in pairs(Teleports) do
repeat task.wait() HumanoidRootPart:PivotTo(v) until HumanoidRootPart:FindFirstChild("BlackheartREAL")
repeat task.wait() HumanoidRootPart:PivotTo(v) until HumanoidRootPart:FindFirstChild("BlackheartREAL") == nil
if i~=8 then
game:GetService("ReplicatedStorage").PhaseA:FireServer()
task.wait(.5)
end
end
    end
})

local PhaseTask3 = false
Phase:Toggle({
    Title = "Task 3 (Slap)",
    Callback = function(state)
        PhaseTask3 = state
    end
})

Phase:Divider()

local PhaseFarming = false
local PhaseFarmingToggle
PhaseFarmingToggle = Phase:Toggle({
    Title = "Start Farming",
	Icon = "gravity:sparkles",
    Callback = function(state)
        PhaseFarming = state
		if PhaseFarming==true and (not Character or not HumanoidRootPart or not Humanoid) then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Missing player components, please try again in a few seconds. (Character/HumanoidRootPart/Humanoid)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 4,
        	})
			PhaseFarmingToggle:Set(false)
			PhaseFarming = false
			return
		end
		if PhaseFarming==true and Character:FindFirstChild("entered") then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Should use in lobby.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			PhaseFarmingToggle:Set(false)
			PhaseFarming = false
			return
		end
		if PhaseFarming==true and LocalPlayer:WaitForChild("_unlockedGloves").Phase.Value==false and LocalPlayer.leaderstats.Glove.Value~="Phase" then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You don't own phase. (If you are using rent bug, equip the glove you are getting mastery for and try again)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 6,
        	})
			PhaseFarmingToggle:Set(false)
			PhaseFarming = false
			return
		end
		if PhaseFarming==true and Humanoid.Health==0 then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You are dead.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			PhaseFarmingToggle:Set(false)
			PhaseFarming = false
			return
		end
		if PhaseFarming==true and PhaseTask1==false and PhaseTask3==false then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You need to turn on atleast 1 option.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			PhaseFarmingToggle:Set(false)
			PhaseFarming = false
			return
		end
		if not AltAccountPlayer then
			WindUI:Notify({
    			Title = "Error",
    			Content = "Something went wrong. Try connecting the accounts again.",
    			Icon = "triangle-exclamation",
    			Duration = 3,
			})
			return
		end
if PhaseFarming==true then
if LocalPlayer.leaderstats.Glove.Value~="Phase" then
SelectGlove("Phase")
task.wait(.333)
end
EnterArena(workspace.Lobby["Teleport1"])
TeleportToPosition(workspace["platform1"].CFrame * CFrame.new(0,10,0), 1.5)
NETWORK.send_data("slap")
task.wait(2.5)
local Imgoingtousephase = false
local Didiactivateit = false
repeat task.wait(.8)
if PhaseTask1==true or PhaseTask3==true then
task.spawn(function()
if Didiactivateit==true then return end
Didiactivateit = true
repeat task.wait()
HumanoidRootPart:PivotTo(workspace["platform1"].CFrame * CFrame.new(0,10,0))
Humanoid.Sit = false
until PhaseFarming==false or Humanoid.Health==0
end)
task.spawn(function()
pcall(function()
if Character.Head.Transparency~=1 and Imgoingtousephase==false then
Imgoingtousephase = true
task.wait(1.5)
game:GetService("ReplicatedStorage").PhaseA:FireServer()
repeat task.wait() until Character.Head.Transparency==1
Imgoingtousephase = false
end
end)
end)
pcall(function()
game:GetService("ReplicatedStorage").PhaseH:FireServer(AltAccountPlayer.Character.Head)
end)
end
until PhaseFarming==false or Humanoid.Health==0
Humanoid.Health = 0
LocalPlayer:WaitForChild("Reset"):FireServer()
end
    end
})




