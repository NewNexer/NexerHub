game:GetService("ReplicatedStorage").CloudHit:FireServer(AltAccountPlayer.Character.Head)
end
end)
end
end
until CloudFarming==false or Humanoid.Health==0
Humanoid.Health = 0
LocalPlayer:WaitForChild("Reset"):FireServer()
end
    end
})

