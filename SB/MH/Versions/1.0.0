function CreateMessage(a)
local instancename = (a=="Message" and a) or "Hint"
local msg = Instance.new(instancename,game:GetService("CoreGui"))
msg.Text = ""
return msg
end

local _version = "1.6.66"
local msg = CreateMessage()
msg.Text = "Loading Modules... (0/2)"
local modules = {
	{"WindUI", "https://github.com/Footagesus/WindUI/releases/download/".._version.."/main.lua", true},
	{"AltConnector", "https://raw.githubusercontent.com/NewNexer/NexerHub/refs/heads/main/SB/Modules/Connector.lua", true}
}
if not loaded_modules_sb then
getgenv().loaded_modules_sb = {}
end
local loaded, attempts = {}, {}
for i = 1, #modules do attempts[i] = 0 end
local i = 1
repeat task.wait()
	local suc, res = pcall(function()
		return table.find(loaded_modules_sb, tostring(modules[i][3])) and loaded_modules_sb[tostring(modules[i][3])] or modules[i][3] and loadstring(game:HttpGet(modules[i][2]))() or game:HttpGet(modules[i][2])
	end)
	if not suc then
		attempts[i] += 1
		msg.Text = "Failed loading module '"..modules[i][1].."', retry: "..attempts[i]
		task.wait(1)
	else
		loaded[modules[i][1]] = res
        table.insert(loaded_modules_sb, tostring(modules[i][1]))
		msg.Text = "Loading module '"..modules[i][1].."'... ("..tostring(i).."/2)"
		i += 1
		task.wait(.5)
	end
until i > #modules
local WindUI = loaded["WindUI"]
local StoredConnections = {}
msg.Text = "Launching WindUI..."
task.delay(2, function() msg:Destroy() end)

local existedbefore = true
if not game:GetService("SoundService"):FindFirstChild("nexermusic") then
existedbefore = false
local muted = false
local connections = {}
local mutedlist = {}
function iswhitelisted(sound)
    if not sound:IsA("Sound") and not sound:IsA("SoundGroup") then return false end
    for i,v in ipairs({"nexermusic","MasteryFarmMusic"}) do
        if sound.Name == v then
            return true
        end
    end
    return false
end
function isplaying(sound)
    if sound:IsA("Sound") then
        return sound.IsPlaying
    elseif sound:IsA("SoundGroup") then
        return sound.Volume > 0
    end
    return false
end
function mutesound(sound)
    if not sound:IsA("Sound") and not sound:IsA("SoundGroup") then return end
    if iswhitelisted(sound) then return end
    if not mutedlist[sound] then
        mutedlist[sound] = {
            vol = sound.Volume,
            wasplaying = isplaying(sound)
        }
        sound.Volume = 0
    end
end
function unmutesound(sound)
    if mutedlist[sound] then
        local data = mutedlist[sound]
        if isplaying(sound) or data.wasplaying then
            sound.Volume = data.vol
        else
            sound.Volume = 0
        end
        mutedlist[sound] = nil
    end
end
function onchange(sound,prop)
    if not muted then return end
    if iswhitelisted(sound) then return end
    if prop == "Playing" or prop == "IsPlaying" then
        if sound:IsA("Sound") and sound.IsPlaying and mutedlist[sound] then
            mutedlist[sound].wasplaying = true
        end
    elseif prop == "Volume" then
        if sound.Volume > 0 and not iswhitelisted(sound) then
            sound.Volume = 0
        end
    end
end
function processall(mute)
    for i,v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Sound") then
            if mute then
                mutesound(v)
            else
                unmutesound(v)
            end
        end
    end
    for i,v in ipairs(game:GetService("SoundService"):GetChildren()) do
        if v:IsA("SoundGroup") then
            if mute then
                mutesound(v)
            else
                unmutesound(v)
            end
        end
    end
end
function listen(sound)
    if not sound:IsA("Sound") then return end
    local a = sound:GetPropertyChangedSignal("Playing"):Connect(function()
        onchange(sound,"Playing")
    end)
    local b = sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        onchange(sound,"IsPlaying")
    end)
    local c = sound:GetPropertyChangedSignal("Volume"):Connect(function()
        onchange(sound,"Volume")
    end)
    sound.Destroying:Connect(function()
        a:Disconnect()
        b:Disconnect()
        c:Disconnect()
        mutedlist[sound] = nil
    end)
end
function managelisteners(on)
    if on then
        connections.desc = workspace.DescendantAdded:Connect(function(v)
            if v:IsA("Sound") then
                listen(v)
                if muted then
                    mutesound(v)
                end
            end
        end)
        for i,v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Sound") then
                listen(v)
            end
        end
    else
        for i,v in pairs(connections) do
            v:Disconnect()
        end
        connections = {}
    end
end
function SetSounds(on)
    if on then
        processall(false)
        managelisteners(false)
        muted = false
    else
        processall(true)
        managelisteners(true)
        muted = true
    end
end
managelisteners(true)
SetSounds(false)
local MusicHolder = Instance.new("Sound")
MusicHolder.Name = "nexermusic"
MusicHolder.Looped = true
MusicHolder.SoundId = "rbxassetid://108407497849204"
MusicHolder.Volume = 2
MusicHolder.Parent = game:GetService("SoundService")
MusicHolder:Play()
end
