local FetchedHumanoids = {}
local FetchedMannequins = {}
for i,v in next, game:GetService("ReplicatedStorage").Assets:GetDescendants() do
if v and v:IsA("Model") and v:FindFirstChild("isInArena") and v.isInArena.Value==true and v:FindFirstChild("Head") then
if v.Parent.Name=="Mannequin" then
table.insert(FetchedMannequins,v.Head)
end
table.insert(FetchedHumanoids,v.Head)
end
end

if workspace:FindFirstChild("platform1")==nil then
local platform1 = Instance.new("Part")
platform1.Position = Vector3.new(20000,20000,20000)
platform1.Size = Vector3.new(2048,4,2048)
platform1.Anchored = true
platform1.Transparency = 0.5
platform1.CanCollide = true
platform1.Name = "platform1"
platform1.Parent = workspace
end

-- Glovel tab
Glovel = Window:Tab({
    Title = "Glovel",
    Icon = "gravity:sparkles-fill",
})

GlovelTask1 = false
Glovel:Toggle({
    Title = "Task 1 (Dig)",
    Callback = function(state)
        GlovelTask1 = state
    end
})

GlovelTask2 = false
Glovel:Toggle({
    Title = "Task 2 (Land crits)",
	Desc = "No Alt Required — 12x slap speed",
	Icon = "gravity:sparkles-fill",
    Callback = function(state)
        GlovelTask2 = state
    end
})

GlovelTask3 = false
Glovel:Toggle({
    Title = "Task 3 (Land crits in a row)",
	Desc = "No Alt Required — 12x slap speed",
	Icon = "gravity:sparkles-fill",
    Callback = function(state)
        GlovelTask3 = state
    end
})

Glovel:Divider()

GlovelFarming = false
GlovelFarmingToggle = nil
GlovelFarmingToggle = Glovel:Toggle({
    Title = "Start Farming",
	Icon = "gravity:sparkles-fill",
    Callback = function(state)
        GlovelFarming = state
		if GlovelFarming==true and (not Character or not HumanoidRootPart or not Humanoid) then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Missing player components, please try again in a few seconds. (Character/HumanoidRootPart/Humanoid)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 4,
        	})
			GlovelFarmingToggle:Set(false)
			GlovelFarming = false
			return
		end
		if GlovelFarming==true and Character:FindFirstChild("entered") then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Should use in lobby.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			GlovelFarmingToggle:Set(false)
			GlovelFarming = false
			return
		end
		if GlovelFarming==true and LocalPlayer:WaitForChild("_unlockedGloves").Glovel.Value==false and LocalPlayer.leaderstats.Glove.Value~="Glovel" then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You don't own glovel. (If you are using rent bug, equip the glove you are getting mastery for and try again)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 6,
        	})
			GlovelFarmingToggle:Set(false)
			GlovelFarming = false
			return
		end
		if GlovelFarming==true and Humanoid.Health==0 then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You are dead.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			GlovelFarmingToggle:Set(false)
			GlovelFarming = false
			return
		end
		if GlovelFarming==true and GlovelTask2==false and GlovelTask3==false and GlovelTask1==false then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You need to turn on atleast 1 option.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			GlovelFarmingToggle:Set(false)
			GlovelFarming = false
			return
		end
if GlovelFarming==true then
if LocalPlayer.leaderstats.Glove.Value~="Glovel" then
SelectGlove("Glovel")
task.wait(.333)
end
EnterArena(workspace.Lobby["Teleport1"])
TeleportToPosition(workspace["platform1"].CFrame * CFrame.new(math.random(-500,500),10,math.random(-500,500)), 4)
repeat task.wait(.05)
if GlovelTask1==true and Character and Character:FindFirstChild("Head") then
if Character.Head.Transparency~=1 then
game:GetService("ReplicatedStorage").GlovelFunc:InvokeServer()
else
game:GetService("ReplicatedStorage").GlovelCancel:FireServer()
end
end
if GlovelTask2==true or GlovelTask3==true then
for i,v in next, FetchedMannequins do
game:GetService("ReplicatedStorage").GeneralHit:FireServer(v, true)
end
end
until GlovelFarming==false or Humanoid.Health==0
Humanoid.Health = 0
LocalPlayer:WaitForChild("Reset"):FireServer()
end
    end
})

