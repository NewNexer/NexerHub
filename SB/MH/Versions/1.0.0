end
local movingcloudh = false
local launchedflytask = false
local function startflytaskidk()
	if movingcloudh==true then return end
	if not workspace:FindFirstChild(LocalPlayer.Name.."_Cloud") or not workspace[LocalPlayer.Name.."_Cloud"]:FindFirstChild("VehicleSeat") then return end
    if workspace[LocalPlayer.Name.."_Cloud"].VehicleSeat.Occupant==nil then return end
    local center = workspace["platform2"].Position
    local corners = {
        center + Vector3.new(-20, 0, -20),
        center + Vector3.new(20, 0, -20),
        center + Vector3.new(20, 0, 20),
        center + Vector3.new(-20, 0, 20)
    }
    local corneer = 1
	movingcloudh = true
	local emptyvar = true
    repeat task.wait()
        if workspace:FindFirstChild(LocalPlayer.Name.."_Cloud") and workspace[LocalPlayer.Name.."_Cloud"]:FindFirstChild("VehicleSeat") and workspace[LocalPlayer.Name.."_Cloud"].VehicleSeat.Occupant~=nil then
			pcall(function()
            	local tempdirection = (Vector3.new(corners[corneer].X, center.Y, corners[corneer].Z)-workspace[LocalPlayer.Name.."_Cloud"].Position)
            	local newdirection = Vector3.new(tempdirection.X, 0, tempdirection.Z)
            	if newdirection.Magnitude < 2 then
                	corneer = corneer + 1
                	if corneer > 4 then
                    	corneer = 1
                	end
            	else
                	workspace[LocalPlayer.Name.."_Cloud"].BodyVelocity.Velocity = newdirection.Unit * 400
            	end
            	workspace[LocalPlayer.Name.."_Cloud"].BodyGyro.CFrame = CFrame.lookAt(workspace[LocalPlayer.Name.."_Cloud"].Position, workspace[LocalPlayer.Name.."_Cloud"].Position + newdirection.Unit)
			end)
        else
            break
        end
    until emptyvar==false
	movingcloudh = false
end
repeat task.wait(.05)
if CloudTask1==true or CloudTask2==true or CloudTask3==true or CloudTask4==true then
if not workspace:FindFirstChild(LocalPlayer.Name.."_Cloud") then
game:GetService("ReplicatedStorage").CloudAbility:FireServer()
repeat task.wait() until workspace:FindFirstChild(LocalPlayer.Name.."_Cloud") or CloudFarming==false or Humanoid.Health==0
task.wait(.25)
end
if workspace[LocalPlayer.Name.."_Cloud"].VehicleSeat.Occupant==nil then
TeleportToPosition(workspace[LocalPlayer.Name.."_Cloud"].VehicleSeat.CFrame, 0.5)
end
if CloudTask3==true then
if launchedflytask==false then
launchedflytask = true
task.spawn(function()
repeat task.wait()
task.spawn(startflytaskidk)
until CloudFarming==false or Humanoid.Health==0
end)
end
end
if CloudTask1==true then
pcall(function()
Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
PressKey("Space")
