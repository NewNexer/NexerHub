    Title = "Start Farming",
	Icon = "gravity:sparkles-fill",
    Callback = function(state)
        spinFarming = state
		if spinFarming==true and (not Character or not HumanoidRootPart or not Humanoid) then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Missing player components, please try again in a few seconds. (Character/HumanoidRootPart/Humanoid)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 4,
        	})
			spinFarmingToggle:Set(false)
			spinFarming = false
			return
		end
		if spinFarming==true and Character:FindFirstChild("entered") then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Should use in lobby.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			spinFarmingToggle:Set(false)
			spinFarming = false
			return
		end
		if spinFarming==true and Humanoid.Health==0 then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You are dead.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			spinFarmingToggle:Set(false)
			spinFarming = false
			return
		end
		if spinFarming==true and spinTask1==false then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You need to turn on atleast 1 option.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			spinFarmingToggle:Set(false)
			spinFarming = false
			return
		end
if spinFarming==true then
if LocalPlayer.leaderstats.Glove.Value~="spin" then
SelectGlove("spin")
task.wait(.333)
end
EnterArena(workspace.Lobby["Teleport1"])
TeleportToPosition(workspace["platform1"].CFrame * CFrame.new(math.random(-500,500),10,math.random(-500,500)), 2)
repeat task.wait(.05)
HumanoidRootPart.Anchored = true
until spinFarming==false or Humanoid.Health==0
Humanoid.Health = 0
LocalPlayer:WaitForChild("Reset"):FireServer()
end
    end
})

