game:GetService("ReplicatedStorage").GeneralHit:FireServer(AltAccountPlayer.Character.Head)
end)
until (Character:GetAttribute("CleanKillStreak")~=nil and Character:GetAttribute("CleanKillStreak")==5) or Humanoid.Health==0
Humanoid.Health = 0
LocalPlayer:WaitForChild("Reset"):FireServer()
    end
})

local EgglerTask2 = false
Eggler:Toggle({
    Title = "Task 2 (Unegg with violence)",
    Callback = function(state)
        EgglerTask2 = state
    end
})

local EgglerTask3 = false
Eggler:Toggle({
    Title = "Task 3 (Deny slap trading)",
    Callback = function(state)
        EgglerTask3 = state
    end
})

local EgglerTask4 = false
Eggler:Toggle({
    Title = "Task 4 (Eggify)",
    Callback = function(state)
        EgglerTask4 = state
    end
})


Eggler:Divider()

local EgglerFarming = false
local EgglerFarmingToggle
EgglerFarmingToggle = Eggler:Toggle({
    Title = "Start Farming",
	Icon = "gravity:sparkles",
    Callback = function(state)
        EgglerFarming = state
		if EgglerFarming==true and (not Character or not HumanoidRootPart or not Humanoid) then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Missing player components, please try again in a few seconds. (Character/HumanoidRootPart/Humanoid)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 4,
        	})
			EgglerFarmingToggle:Set(false)
			EgglerFarming = false
			return
		end
		if EgglerFarming==true and Character:FindFirstChild("entered") then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Should use in lobby.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			EgglerFarmingToggle:Set(false)
			EgglerFarming = false
			return
		end
		if EgglerFarming==true and LocalPlayer:WaitForChild("_unlockedGloves").Eggler.Value==false and LocalPlayer.leaderstats.Glove.Value~="Eggler" then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You don't own eggler. (If you are using rent bug, equip the glove you are getting mastery for and try again)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 6,
        	})
			EgglerFarmingToggle:Set(false)
			EgglerFarming = false
			return
		end
		if EgglerFarming==true and Humanoid.Health==0 then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You are dead.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			EgglerFarmingToggle:Set(false)
			EgglerFarming = false
			return
		end
		if EgglerFarming==true and EgglerTask2==false and EgglerTask3==false and EgglerTask4==false then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You need to turn on atleast 1 option.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			EgglerFarmingToggle:Set(false)
			EgglerFarming = false
			return
		end
		if not AltAccountPlayer then
			WindUI:Notify({
    			Title = "Error",
    			Content = "Something went wrong. Try connecting the accounts again.",
    			Icon = "triangle-exclamation",
    			Duration = 3,
			})
			return
		end
if EgglerFarming==true then
if LocalPlayer.leaderstats.Glove.Value~="Eggler" then
SelectGlove("Eggler")
task.wait(.333)
end
EnterArena(workspace.Lobby["Teleport1"])
TeleportToPosition(workspace["platform1"].CFrame * CFrame.new(0,10,0), 1.5)
HumanoidRootPart.Anchored = true
NETWORK.send_data("init_close_range_same_y_level")
task.wait(2.5)
local canslap = true
repeat task.wait(.05)
if EgglerTask2==true or EgglerTask3==true or EgglerTask4==true then
if EgglerTask2==true or EgglerTask3==true then
game:GetService("ReplicatedStorage").Events.EgglerRAbility:FireServer()
end
if EgglerTask4==true then
game:GetService("ReplicatedStorage").GeneralAbility:FireServer()
end
if canslap==true then
canslap = false
pcall(function()
if EgglerTask2==true or EgglerTask3==true then
game:GetService("ReplicatedStorage").GeneralHit:FireServer(AltAccountPlayer.Character.Head)
end
end)
task.delay(.8, function() canslap = true end)
end
end
until EgglerFarming==false or Humanoid.Health==0
HumanoidRootPart.Anchored = false
Humanoid.Health = 0
LocalPlayer:WaitForChild("Reset"):FireServer()
end
    end
})



