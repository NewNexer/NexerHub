            	Content = "Should use in lobby.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			REDACTEDFarmingToggle:Set(false)
			REDACTEDFarming = false
			return
		end
		if REDACTEDFarming==true and LocalPlayer:WaitForChild("_unlockedGloves")["[REDACTED]"].Value==false and LocalPlayer.leaderstats.Glove.Value~="[REDACTED]" then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You don't own [REDACTED]. (If you are using rent bug, equip the glove you are getting mastery for and try again)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 6,
        	})
			REDACTEDFarmingToggle:Set(false)
			REDACTEDFarming = false
			return
		end
		if REDACTEDFarming==true and Humanoid.Health==0 then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You are dead.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			REDACTEDFarmingToggle:Set(false)
			REDACTEDFarming = false
			return
		end
		if REDACTEDFarming==true and REDACTEDTask2==false and REDACTEDTask3==false then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You need to turn on atleast 1 option.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			REDACTEDFarmingToggle:Set(false)
			REDACTEDFarming = false
			return
		end
if REDACTEDFarming==true then
if LocalPlayer.leaderstats.Glove.Value~="[REDACTED]" then
SelectGlove("[REDACTED]")
task.wait(.333)
end
EnterArena(workspace.Lobby["Teleport1"])
TeleportToPosition(workspace["platform1"].CFrame * CFrame.new(0,10,0), 1.5)
if REDACTEDUseAlt==true and REDACTEDTask2==true then
NETWORK.send_data("init_close_range_same_y_level")
task.wait(2.5)
NETWORK.send_data("init_redacted")
end
repeat task.wait(.05)
if REDACTEDTask2==true or REDACTEDTask3==true then
task.wait(1)
game:GetService("ReplicatedStorage"):WaitForChild("Well"):FireServer()
task.wait(2)
for i,v in next, game:GetService("Players"):GetPlayers() do
game:GetService("ReplicatedStorage").WellCapture:FireServer(v)
end
task.wait(2)
end
until REDACTEDFarming==false or Humanoid.Health==0
Humanoid.Health = 0
LocalPlayer:WaitForChild("Reset"):FireServer()
end
    end
})
