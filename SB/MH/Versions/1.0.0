local targetid = 000
game:GetService("LogService").MessageOut:Connect(function(message, ...)
    local asset = string.match(message, "rbxassetid://(%d+)")
    if asset and string.sub(asset, 1, 3) == tostring(targetid) then
		print("gotcha: "..asset.."")
        local funcinfo = string.sub(asset, -2)
		print("func fetched: "..string.sub(asset, -2).."")
        ReceiveData(tostring(funcinfo))
    end
end)

local AltAccountPlayer

local Connector = Window:Tab({
    Title = "Connector",
    Desc = "Connector between you and your alt account.",
    Icon = "gravity:antenna-signal",
})

Connector:Paragraph({
    Title = "Instructions",
    Desc = "On main account, write your alt's account username in ''Alt Account Username'' input bar\n\nOn alt account, write your main account username in ''Main Account Username'' input bar",
    Image = "gravity:shield-exclamation",
    ImageSize = 20
})

local temptempconnectorstopvar = true

Connector:Input({
    Title = "Main Account Username",
    Placeholder = "Nexer",
    Value = "",
    Callback = function(text)
		if temptempconnectorstopvar==true then return end
        if not game:GetService("Players"):FindFirstChild(text) then
            WindUI:Notify({
                Title = "Error",
                Content = "Player not found!",
                Icon = "gravity:triangle-exclamation",
                Duration = 3,
            })
            return
        end
        WindUI:Notify({
            Title = "Success",
            Content = "Connected player!",
            Icon = "check",
            Duration = 5,
        })
        if game:GetService("Players"):WaitForChild(text)==LocalPlayer then
            return
        end
	MainAccountPlayer = game:GetService("Players"):WaitForChild(text)
	targetid = string.sub(tostring(MainAccountPlayer.UserId), -3)
    end
})

Connector:Input({
    Title = "Alt Account Username",
    Placeholder = "Freyaa",
    Value = "",
    Callback = function(text)
		if temptempconnectorstopvar==true then return end
        if not game:GetService("Players"):FindFirstChild(text) then
            WindUI:Notify({
                Title = "Error",
                Content = "Player not found!",
                Icon = "gravity:triangle-exclamation",
                Duration = 3,
            })
            return
        end
        WindUI:Notify({
            Title = "Success",
            Content = "Connected player!",
            Icon = "check",
            Duration = 5,
        })
        if game:GetService("Players"):WaitForChild(text)==LocalPlayer then
            return
        end
	AltAccountPlayer = game:GetService("Players"):WaitForChild(text)
    end
})

task.delay(0.2, function() temptempconnectorstopvar = false end)


