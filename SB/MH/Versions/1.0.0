local canslap = true
repeat task.wait(.05)
if SpringTask1==true or SpringTask2==true or SpringTask3==true then
Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
game:GetService("ReplicatedStorage").SpringJump:FireServer()
PressKey("Space")
if canslap==true then
canslap = false
pcall(function()
game:GetService("ReplicatedStorage").springhit:FireServer(AltAccountPlayer.Character.Head)
end)
