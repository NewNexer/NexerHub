if existedbefore==false then
game:GetService("SoundService"):WaitForChild("nexermusic"):Stop()
task.wait()
game:GetService("SoundService"):WaitForChild("nexermusic").SoundId = "rbxassetid://"..tostring(111405430613058)
game:GetService("SoundService"):WaitForChild("nexermusic"):Play()
end
end)

