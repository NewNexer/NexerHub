-- Frostbite tab 
Frostbite = Window:Tab({
    Title = "Frostbite",
    Icon = "gravity:sparkles",
})

FrostbiteTask2 = false
Frostbite:Toggle({
    Title = "Task 2 (Slap frozen)",
    Callback = function(state)
        FrostbiteTask2 = state
    end
})

FrostbiteTask3 = false
Frostbite:Toggle({
    Title = "Task 3 (Freeze 10 players)",
    Callback = function(state)
        FrostbiteTask3 = state
    end
})

FrostbiteTask4 = false
Frostbite:Toggle({
    Title = "Task 4 (Engulf players)",
    Callback = function(state)
        FrostbiteTask4 = state
    end
})

Frostbite:Divider()

FrostbiteFarming = false
FrostbiteFarmingToggle = nil
FrostbiteFarmingToggle = Frostbite:Toggle({
    Title = "Start Farming",
	Icon = "gravity:sparkles",
    Callback = function(state)
        FrostbiteFarming = state
		if FrostbiteFarming==true and (not Character or not HumanoidRootPart or not Humanoid) then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Missing player components, please try again in a few seconds. (Character/HumanoidRootPart/Humanoid)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 4,
        	})
			FrostbiteFarmingToggle:Set(false)
			FrostbiteFarming = false
			return
		end
		if FrostbiteFarming==true and Character:FindFirstChild("entered") then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "Should use in lobby.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			FrostbiteFarmingToggle:Set(false)
			FrostbiteFarming = false
			return
		end
		if FrostbiteFarming==true and LocalPlayer:WaitForChild("_unlockedGloves").Frostbite.Value==false and LocalPlayer.leaderstats.Glove.Value~="Frostbite" then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You don't own frostbite. (If you are using rent bug, equip the glove you are getting mastery for and try again)",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 6,
        	})
			FrostbiteFarmingToggle:Set(false)
			FrostbiteFarming = false
			return
		end
		if FrostbiteFarming==true and Humanoid.Health==0 then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You are dead.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			FrostbiteFarmingToggle:Set(false)
			FrostbiteFarming = false
			return
		end
		if FrostbiteFarming==true and FrostbiteTask3==false and FrostbiteTask2==false and FrostbiteTask4==false then
        	WindUI:Notify({
            	Title = "Error",
            	Content = "You need to turn on atleast 1 option.",
            	Icon = "gravity:triangle-exclamation",
            	Duration = 3,
        	})
			FrostbiteFarmingToggle:Set(false)
			FrostbiteFarming = false
			return
		end
		if not AltAccountPlayer then
			WindUI:Notify({
    			Title = "Error",
    			Content = "Alt account not detected! Please connect the accounts!",
    			Icon = "triangle-exclamation",
    			Duration = 3,
			})
			return
		end
if FrostbiteFarming==true then
if LocalPlayer.leaderstats.Glove.Value~="Frostbite" then
SelectGlove("Frostbite")
task.wait(.333)
end
EnterArena(workspace.Lobby["Teleport1"])
TeleportToPosition(CFrame.new(1620, 90, 8934), 2)
NETWORK.send_data("08")
task.wait(2.5)
HumanoidRootPart.Anchored = true
local canslap = true
repeat task.wait(.8)
if FrostbiteTask2==true or FrostbiteTask3==true or FrostbiteTask4==true then
game:GetService("ReplicatedStorage").GeneralAbility:FireServer(0.3,2)
if FrostbiteTask2==true then
pcall(function()
if AltAccountPlayer.Character:GetAttribute("frostbite")~=nil and AltAccountPlayer.Character:GetAttribute("frostbite")==true then
game:GetService("ReplicatedStorage").GeneralHit:FireServer(AltAccountPlayer.Character.Head)
end
end)
end
end
until FrostbiteFarming==false or Humanoid.Health==0
HumanoidRootPart.Anchored = false
Humanoid.Health = 0
LocalPlayer:WaitForChild("Reset"):FireServer()
end
    end
})


